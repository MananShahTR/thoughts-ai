datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Thought {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  sentiment Float

  themes    ThoughtTheme[]

  @@index([createdAt])
}

enum Period {
  week
  month
  year
  all
}

model Theme {
  id          Int      @id @default(autoincrement())
  word        String
  count       Int
  period      Period
  generatedAt DateTime @default(now())

  thoughts    ThoughtTheme[]
}

model ThoughtTheme {
  thought   Thought @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  thoughtId Int

  theme     Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)
  themeId   Int

  @@id([thoughtId, themeId])
  @@index([themeId])
}