datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Thought {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  sentiment Float

  @@index([createdAt])
}

enum Period {
  week
  month
  year
  all
}

model Theme {
  id          Int      @id @default(autoincrement())
  word        String
  count       Int
  period      Period
  generatedAt DateTime @default(now())
}